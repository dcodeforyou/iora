# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / session artifacts — not part of the app
.claude/
.playwright-mcp/

# raw source uploads already processed into public/ (transcoded/copied) —
# these root-level originals are redundant duplicates, not referenced by
# any code, and only bloat the repo
/iora_master_web.mp4
/iora_master_mobile.MOV
/product-ad.mp4
/product-motion.mp4
/product-websites.mp4
/future-club.mp3
/iora-footer.mp4

# unused scratch/leftover assets from earlier work, not referenced anywhere
/elza.zip
/gel1.mov
/gel2.mov
/pp-neue-montreal-cufonfonts.zip
/a_smooth.svg
/b_smooth.svg
/c_smooth.svg
